# launch-webapp.bat runs Postgres on host port 5433 (5432 is often already taken).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ecommerce?schema=public"
JWT_SECRET="change-me-in-development"
PORT=3000
CLIENT_URL="http://localhost:5173"
ADMIN_URL="http://localhost:5174"
# Web Push (VAPID). Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Google OAuth. The browser sends an access token; the server checks that Google
# issued it for one of these client ids before trusting it. Without this the API
# would accept a token minted for any other Google app, so leaving it empty
# disables Google sign-in entirely (every attempt is rejected).
# Comma-separate the values if the storefront and the admin app use different clients.
GOOGLE_CLIENT_ID=
# No client secret is needed: this flow only verifies tokens, it never exchanges a code.
