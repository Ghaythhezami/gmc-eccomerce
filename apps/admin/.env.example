VITE_API_URL="http://localhost:3000/api"
VITE_STOREFRONT_URL="http://localhost:5173"

# Google OAuth *client ID* (public, safe in the browser bundle). Never put the client
# secret in a VITE_ variable - anything VITE_ prefixed is shipped to the browser.
# Add http://localhost:5174 as an authorized JavaScript origin for this client.
# Leave empty to run without Google sign-in (the button is disabled).
VITE_GOOGLE_CLIENT_ID=
